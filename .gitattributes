# =============================================================================
# SecureShare — line endings
#
# You develop on Windows and deploy to Linux. Git's autocrlf can convert files
# to CRLF on checkout, and a few of the files here BREAK if that happens —
# with error messages that do not mention line endings at all.
#
# The most dangerous one:
#
#   Backend/sql/000_roles.sh  runs inside the Postgres container on first boot,
#                             creating the least-privilege app_rw role. With
#                             CRLF the kernel reads the shebang as
#                             "/bin/bash\r" and the container dies with
#                             "bad interpreter: /bin/bash^M: No such file or
#                             directory". Postgres then initialises WITHOUT the
#                             role split, the backend cannot connect as app_rw,
#                             and the audit table loses its append-only
#                             guarantee. Nothing in the app logs says why.
# =============================================================================

# Let Git decide for anything it recognises as text.
* text=auto

# Always LF, on every platform, no exceptions. These are read by Linux.
*.sh            text eol=lf
*.sql           text eol=lf
*.py            text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
.env.example    text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Frontend sources — LF keeps diffs clean across machines.
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.cjs           text eol=lf
*.mjs           text eol=lf
*.json          text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.md            text eol=lf

# Binary — never touched, never diffed.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.pdf           binary
*.gz            binary
*.zip           binary

# Generated — collapse the noise in pull requests.
package-lock.json  linguist-generated=true -diff
