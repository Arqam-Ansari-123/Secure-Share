# =============================================================================
# SecureShare — the SERVER's .env.  Copy to the repo root ON THE SERVER as .env
#
#     cp deploy/env.production.example .env && nano .env
#
# Do NOT copy the laptop's .env up. Every secret below is generated fresh on the
# server; the only values carried over from development are the AD block.
#
# Generate each password/secret with:      openssl rand -base64 24
# =============================================================================

# --- database ----------------------------------------------------------------
# READ ONLY ONCE, when the pgdata volume is FIRST created. Changing either value
# after the first `up` does nothing to the running database — it just stops the
# app connecting. Set both before the very first start.
DB_PASSWORD=REPLACE_openssl_rand_base64_24
APP_DB_PASSWORD=REPLACE_openssl_rand_base64_24

# --- app ----------------------------------------------------------------------
# This is the switch that turns on Secure cookies, the __Host- cookie prefix,
# HSTS, HTTPSRedirectMiddleware, and that hides /docs, /redoc and /openapi.json.
# It is also why TLS is mandatory: over plain HTTP the browser silently discards
# the session cookie and login loops forever while the API keeps returning 200.
ENV=production

# The origin STAFF use. Drives CORS and the CSRF Origin check.
FRONTEND_ORIGIN=https://vault.genetechsolutions.com

# The origin baked into every share link the backend hands out. This is why a
# link created while browsing vault. still comes out as https://share./s/<token>.
PUBLIC_BASE_URL=https://share.genetechsolutions.com

# BOTH hostnames. A missing entry produces a bare 400 Invalid host header with
# no log line, which is indistinguishable from an outage. `backend` covers any
# future container-to-container call.
ALLOWED_HOSTS=vault.genetechsolutions.com,share.genetechsolutions.com,backend

# HMAC key for outbound webhook signatures (X-SecureShare-Signature).
WEBHOOK_SECRET=REPLACE_openssl_rand_base64_24

# Mixed into local password hashes; never stored in the database, so a stolen
# pg_dump cannot be cracked offline. SET IT NOW OR NEVER — adding or changing it
# later invalidates every existing local password, including the break-glass one.
PASSWORD_PEPPER=REPLACE_openssl_rand_base64_24

# --- Active Directory (identical to the working development values) -----------
AD_ENABLED=true

# The HOSTNAME, never the IP: the DC's certificate carries DC01.genetech.pk as
# its only SAN and TLS validation compares against it. config.py refuses to
# start if this is an IP while AD_CA_CERT is set. The name does not resolve on
# the server, so docker-compose maps it via extra_hosts using AD_IP below.
AD_HOST=DC01.genetech.pk

# Reached over the Tailscale subnet route, not over the internet.
AD_IP=192.168.11.49
AD_PORT=636
AD_TLS_MODE=ldaps

# Path AS SEEN INSIDE THE CONTAINER. ./Backend/certs is mounted at /certs:ro.
AD_CA_CERT=/certs/genetech-ca.pem

AD_BASE_DN=DC=genetech,DC=pk
AD_NETBIOS=GENETECH
AD_UPN_SUFFIX=genetech.pk

# Read-only. Translates a typed identifier into a Windows username and nothing
# else — it authenticates nobody. ROTATE IT: this value was shared over chat.
AD_BIND_USER=dev01@genetech.pk
AD_BIND_PASSWORD=REPLACE_with_the_real_bind_password

# Only members of this group may sign in. Applied inside the directory search,
# so a non-member never reaches a bind and their badPwdCount is never touched.
# LEAVE IT SET — empty admits every enabled account in the forest.
AD_REQUIRED_GROUP=CN=active-employee,OU=Groups,DC=genetech,DC=pk

# Pakistan <-> US is roughly 250 ms RTT and a sign-in makes about ten round
# trips, so expect 2-2.5 s per login. 8 s is comfortably above that.
AD_TIMEOUT=8
AD_TIMING_FLOOR_MS=250

# Keep at least one local account. It is the break-glass path for when the DC or
# the tunnel is down — which is exactly when you want a credential-sharing tool.
LOCAL_LOGIN_ENABLED=true

STAFF_EMAIL_DOMAINS=genetech.pk,genetech.co,genetechsolutions.com,consulnet.net,genetech.io,codegirls.pro

# --- optional email on view; empty SMTP_HOST disables it ----------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=secureshare@genetechsolutions.com
