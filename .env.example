# SecureShare — copy to .env and adjust. Never commit .env.

# postgres superuser/owner (schema owner; NOT what the app connects as)
DB_PASSWORD=changeme

# the least-privilege role the application connects as (cannot UPDATE/DELETE audit rows)
APP_DB_PASSWORD=app_rw_dev_password

ENV=development
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# HMAC key for outbound webhook signatures (X-SecureShare-Signature)
WEBHOOK_SECRET=dev-webhook-secret

# --- Active Directory -------------------------------------------------------
# Sign-in is two steps:
#   1. a READ-ONLY bind account turns what the user typed (username, UPN or mail
#      address) into their Windows username;
#   2. the backend then binds to the DC AS THAT USER with the password they
#      supplied — that bind is the password check.
#
# The bind account authenticates nobody and confers no SecureShare privilege. It
# exists because the forest uses several UPN suffixes and a mail domain that
# often differs from the UPN domain, so a bind name cannot be derived from an
# address without looking it up.
AD_ENABLED=false

# Use the DC's FQDN, not its IP, whenever TLS is on: the certificate is issued to
# the name and validation compares against it. config.py REFUSES to start if this
# is an IP while AD_CA_CERT is set. The container needs to resolve the name,
# hence extra_hosts in docker-compose.yml (which uses AD_IP).
AD_HOST=DC01.genetech.pk
AD_IP=192.168.11.49
AD_PORT=636

# ldaps    -> TLS from the first byte on 636                (preferred)
# starttls -> upgrade on 389 before the password is sent
# none     -> NO ENCRYPTION, lab only. Refused when ENV=production.
AD_TLS_MODE=ldaps

# AD publishes its own CA certificate. Fetch it with:
#     python manage.py export-ad-ca
AD_CA_CERT=/certs/genetech-ca.pem        # required in production

AD_BASE_DN=DC=genetech,DC=pk             # subtree: covers OU=people AND CN=Users
AD_NETBIOS=GENETECH                      # binds as GENETECH\<sAMAccountName>
AD_UPN_SUFFIX=genetech.pk                # only a fallback for building an address

# Read-only. Never logged. Rotate on any suspicion — it can enumerate the
# directory, which is all a leaked copy would buy an attacker.
AD_BIND_USER=dev01@genetech.pk
AD_BIND_PASSWORD=

# Only members of this group may sign in. Applied inside the directory search,
# so a non-member never reaches a bind attempt and their badPwdCount is never
# touched. LEAVE THIS SET: empty admits every enabled account in the forest.
AD_REQUIRED_GROUP=CN=active-employee,OU=Groups,DC=genetech,DC=pk

AD_TIMEOUT=8
AD_TIMING_FLOOR_MS=250                   # pads failures so timing cannot enumerate accounts

# Keep at least one local account: it is the break-glass path when the DC is
# unreachable, and SecureShare is exactly the tool you would want while fixing it.
LOCAL_LOGIN_ENABLED=true

# Only consulted by manage.py when creating a LOCAL account.
STAFF_EMAIL_DOMAINS=genetech.pk,genetech.co,genetechsolutions.com,consulnet.net,genetech.io,codegirls.pro

# optional email notification on view; leave SMTP_HOST empty to disable
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=secureshare@genetechsolutions.com
